% Generated by hand for the conditional YLL API.
\name{conditional_yll}
\alias{conditional_yll}
\title{Estimate conditional years of life lost by regression methods}
\usage{
conditional_yll(
  data,
  method = c("poisson", "flexible_parametric"),
  id_var = "id",
  time_var,
  event_var,
  exposure_var,
  reference_level = NULL,
  exposed_level = NULL,
  age_at_entry_var,
  confounders_baseline = NULL,
  age_start = 50,
  age_end = 100,
  age_interval = 5,
  prediction_interval = 1,
  B = 1000,
  seed = 1,
  conf_level = 0.95,
  integration = c("left_rectangle", "trapezoidal"),
  rp_df = 4,
  rp_model = c("combined", "stratified"),
  show_progress = TRUE
)
}
\arguments{
\item{data}{A \code{data.frame} with one row per individual.}
\item{method}{\code{"poisson"} for an age-split Poisson rate model, or \code{"flexible_parametric"} for a Royston-Parmar model via \code{rstpm2}.}
\item{id_var, time_var, event_var, exposure_var}{Column names in \code{data}.}
\item{reference_level, exposed_level}{Values labelling the binary exposure levels.}
\item{age_at_entry_var}{Column name for age at study entry.}
\item{confounders_baseline}{Optional baseline covariates. Predictions are averaged over the empirical covariate distribution.}
\item{age_start, age_end, age_interval}{Starting ages for reported YLL.}
\item{prediction_interval}{Age-grid spacing used when integrating survival curves.}
\item{B, seed, conf_level, show_progress}{Bootstrap settings.}
\item{integration}{Numerical integration rule.}
\item{rp_df, rp_model}{Flexible parametric model settings used only for \code{method = "flexible_parametric"}.}
}
\description{
Implements model-based observed-group YLL estimators. This is separate from
\code{\link[=estimand_yll]{estimand_yll()}}, which targets intervention-based
estimands. \code{conditional_yll()} compares the predicted remaining life
expectancy for the reference and exposed groups, optionally conditioning on
baseline covariates.
}
\value{
A list with \code{summary}, \code{detailed_results}, \code{meta},
\code{conditional_survival_point}, and \code{conditional_survival_boot}.
}
